{
  "name": "daily-quest",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "dev:ssr": "ng run daily-quest:serve-ssr",
    "serve:ssr": "node dist/daily-quest/server/main.js",
    "build": "ng build",
    "build:ssr": "ng build && ng run daily-quest:server",
    "build:prod:ssr": "ng build --configuration production && ng run daily-quest:server:production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "heroku-prebuild": "pnpm install --legacy-peer-deps",
    "heroku-postbuild": "ng build",
    "prerender": "ng run daily-quest:prerender",
    "heroku-start": "node dist/your-app/server/main.js",
    "gzip": "gzipper compress --verbose ./dist/",
    "prod": "ng run daily-quest:prerender && pnpm run gzip"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^18.2.14",
    "@angular/common": "^18.2.14",
    "@angular/compiler": "^18.2.14",
    "@angular/core": "^18.2.14",
    "@angular/forms": "^18.2.14",
    "@angular/platform-browser": "^18.2.14",
    "@angular/platform-browser-dynamic": "^18.2.14",
    "@angular/router": "^18.2.14",
    "@ant-design/icons-angular": "^17.0.0",
    "@ctrl/tinycolor": "^4.1.0",
    "date-fns": "^4.1.0",
    "ng-zorro-antd": "17.4.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.1",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.21",
    "@angular/cli": "~18.2.21",
    "@angular/compiler-cli": "^18.2.14",
    "@angular/platform-server": "18.2.14",
    "@types/jasmine": "~4.3.0",
    "@types/node": "^18.19.130",
    "@types/uuid": "^9.0.8",
    "concurrently": "^9.1.2",
    "gzipper": "^4.3.0",
    "jasmine-core": "~4.5.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.0.0",
    "patch-package": "^8.0.1",
    "postinstall-postinstall": "^2.1.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.4.5"
  }
}
