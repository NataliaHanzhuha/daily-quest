{
  "extends": "../tsconfig.app.json",
  "compilerOptions": {
    "outDir": "../dist/server",
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "types": [
      "node"
    ]
  },
  "files": [
    "main.server.ts"
  ],
  "include": [
    "app/**/*.ts"
  ],
  "exclude": [
    "app/**/*.spec.ts"
  ],
  "angularCompilerOptions": {
    "extendedDiagnostics": {
      "checks": {
        "nullishCoalescingNotNullable": "suppress",
        "optionalChainNotNullable": "suppress"
      }
    }
  }
}
